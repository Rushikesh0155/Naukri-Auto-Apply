# Optional. Leave this file alone unless you need one of these.

# Which resume to upload. By default the one file in Resume/ is used, and the
# dashboard lets you pick when there is more than one.
# RESUME_PATH=C:\Users\you\Documents\your-resume.pdf

# Runs always use a real browser, because Naukri blocks headless ones. The
# window is normally parked off-screen where you never see it.
# Set to 1 to bring it on-screen and watch a run happen.
HEADFUL=0

# Change only if port 8777 is already taken on your machine.
# DASHBOARD_PORT=8777
